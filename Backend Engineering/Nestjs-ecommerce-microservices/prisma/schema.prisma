generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  BUYER
  SELLER
  ADMIN
  SUPPORT_AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum SellerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CARD
  PAYPAL
  BANK_TRANSFER
  WALLET
  CASH_ON_DELIVERY
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  IN_TRANSIT
  CUSTOMS_HOLD
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_SENDER
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  DAMAGED_IN_TRANSIT
  NO_LONGER_NEEDED
  BETTER_PRICE_FOUND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_IN_TRANSIT
  ITEM_RECEIVED
  REFUNDED
  COMPLETED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundMethod {
  ORIGINAL_PAYMENT
  STORE_CREDIT
  BANK_TRANSFER
}

enum StoreCreditType {
  REFUND
  PROMOTIONAL
  MANUAL_ADJUSTMENT
  REDEMPTION
}

enum ComplaintCategory {
  PRODUCT_QUALITY
  DELIVERY_ISSUE
  SELLER_BEHAVIOR
  PAYMENT_ISSUE
  COUNTERFEIT
  ACCOUNT_ISSUE
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  AWAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationType {
  ORDER_UPDATE
  SHIPMENT_UPDATE
  PROMOTION
  REVIEW_REQUEST
  COMPLAINT_UPDATE
  REFUND_UPDATE
  SYSTEM
}

// ============================================================
// LOCATION & CURRENCY
// ============================================================

model Currency {
  code              String   @id // ISO 4217, e.g. "USD"
  name              String
  symbol            String
  exchangeRateToUSD Decimal  @db.Decimal(14, 6)
  updatedAt         DateTime @updatedAt

  countries      Country[]
  users          User[]
  products       Product[]
  orders         Order[]
  payments       Payment[]
  refunds        Refund[]
  storeCredits   StoreCredit[]
  shippingRates  ShippingRate[]
}

model Country {
  iso2                String  @id // e.g. "US"
  iso3                String  @unique // e.g. "USA"
  name                String
  phoneCode           String
  defaultCurrencyCode String?
  defaultCurrency     Currency? @relation(fields: [defaultCurrencyCode], references: [code])

  addresses     Address[]
  orderAddresses OrderAddress[]
  warehouses    Warehouse[]
  sellerProfiles SellerProfile[]
  taxRates      TaxRate[]
  shippingZones ShippingZone[]

  @@index([defaultCurrencyCode])
}

// ============================================================
// USER & IDENTITY
// ============================================================

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role       @default(BUYER)
  status    UserStatus @default(ACTIVE)

  firstName       String?
  lastName        String?
  phone           String?
  emailVerified   Boolean  @default(false)
  phoneVerified   Boolean  @default(false)
  preferredCurrencyCode String?
  preferredCurrency     Currency? @relation(fields: [preferredCurrencyCode], references: [code])
  preferredLanguage String  @default("en")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  addresses         Address[]
  paymentMethods    PaymentMethod[]
  sellerProfile     SellerProfile?
  orders            Order[]
  cart              Cart?
  wishlist          Wishlist?
  productReviews    ProductReview[]
  reviewVotes       ReviewVote[]
  sellerReviews     SellerReview[]
  productQuestions  ProductQuestion[]
  productAnswers    ProductAnswer[]
  returnRequests    ReturnRequest[]
  storeCredits      StoreCredit[]
  couponUsages      CouponUsage[]
  notifications     Notification[]
  complaintsFiled   Complaint[]        @relation("ComplaintComplainant")
  complaintsAssigned Complaint[]       @relation("ComplaintAgent")
  complaintMessages ComplaintMessage[]

  @@index([email, role])
  @@index([status])
  @@index([preferredCurrencyCode])
}

model Address {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String?
  postalCode String
  countryCode String
  country   Country     @relation(fields: [countryCode], references: [iso2])
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([countryCode])
}

model PaymentMethod {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PaymentMethodType
  provider    String // e.g. Stripe, Paystack, PayPal
  token       String // vault token from payment provider - never raw card data
  last4       String?
  expiryMonth Int?
  expiryYear  Int?
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([userId])
}

// ============================================================
// SELLER / MARKETPLACE VENDOR
// ============================================================

model SellerProfile {
  id                        String                    @id @default(uuid())
  userId                    String                    @unique
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName                 String                    @unique
  storeSlug                 String                    @unique
  description               String?
  logoUrl                   String?
  countryCode               String
  country                   Country                   @relation(fields: [countryCode], references: [iso2])
  businessRegistrationNumber String?
  taxId                     String?
  verificationStatus        SellerVerificationStatus  @default(PENDING)
  commissionRate            Decimal                   @default(10.00) @db.Decimal(5, 2)
  avgRating                 Decimal                   @default(0) @db.Decimal(3, 2)
  totalRatings              Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  products     Product[]
  warehouses   Warehouse[]
  orderItems   OrderItem[]
  shipments    Shipment[]
  sellerReviews SellerReview[]
  complaints   Complaint[]

  @@index([countryCode])
  @@index([verificationStatus])
}

model Warehouse {
  id           String   @id @default(uuid())
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  countryCode  String
  country      Country  @relation(fields: [countryCode], references: [iso2])
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  inventory Inventory[]
  shipments Shipment[]

  @@index([sellerId])
  @@index([countryCode])
}

// ============================================================
// CATALOG
// ============================================================

model Brand {
  id      String  @id @default(uuid())
  name    String  @unique
  slug    String  @unique
  logoUrl String?

  products Product[]
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products        Product[]
  applicableCoupons Coupon[]

  @@index([parentId])
}

model Product {
  id           String        @id @default(uuid())
  sku          String        @unique
  name         String
  slug         String        @unique
  description  String?
  brandId      String?
  brand        Brand?        @relation(fields: [brandId], references: [id])
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id])
  currencyCode String
  currency     Currency      @relation(fields: [currencyCode], references: [code])
  basePrice    Decimal       @db.Decimal(10, 2)
  status       ProductStatus @default(DRAFT)
  avgRating    Decimal       @default(0) @db.Decimal(3, 2)
  totalReviews Int           @default(0)
  totalSold    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  variants      ProductVariant[]
  images        ProductImage[]
  reviews       ProductReview[]
  questions     ProductQuestion[]
  wishlistItems WishlistItem[]
  coupons       Coupon[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([sku])
  @@index([basePrice])
  @@index([status])
}

model ProductAttribute {
  id     String                  @id @default(uuid())
  name   String                  @unique // e.g. "Color", "Size"
  values ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String           @id @default(uuid())
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String // e.g. "Red", "XL"

  variants ProductVariant[]

  @@unique([attributeId, value])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String   @unique
  price           Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  weight          Decimal? @db.Decimal(8, 3)
  weightUnit      String   @default("kg")
  barcode         String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attributeValues ProductAttributeValue[]
  images          ProductImage[]
  inventory       Inventory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]

  @@index([productId])
}

model ProductImage {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

model Inventory {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0)
  reservedQuantity Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@unique([productVariantId, warehouseId])
  @@index([warehouseId])
}

// ============================================================
// CART & WISHLIST
// ============================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(1)
  addedAt          DateTime       @default(now())

  @@unique([cartId, productVariantId])
  @@index([cartId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistItem[]
}

model WishlistItem {
  id         String          @id @default(uuid())
  wishlistId String
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  addedAt    DateTime        @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// ============================================================
// SHIPPING (INTERNATIONAL)
// ============================================================

model ShippingZone {
  id        String    @id @default(uuid())
  name      String    @unique // e.g. "North America", "EU", "Rest of World"
  countries Country[]

  rates ShippingRate[]
}

model ShippingMethod {
  id            String   @id @default(uuid())
  name          String // e.g. "Standard", "Express", "International Priority"
  carrier       String // e.g. "DHL", "FedEx", "USPS"
  minDays       Int
  maxDays       Int
  isInternational Boolean @default(false)

  rates     ShippingRate[]
  shipments Shipment[]
}

model ShippingRate {
  id                     String         @id @default(uuid())
  zoneId                 String
  zone                   ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  methodId               String
  method                 ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  baseRate               Decimal        @db.Decimal(10, 2)
  perKgRate              Decimal        @db.Decimal(10, 2)
  freeShippingThreshold  Decimal?       @db.Decimal(10, 2)
  currencyCode           String
  currency               Currency       @relation(fields: [currencyCode], references: [code])

  @@unique([zoneId, methodId])
}

// ============================================================
// TAX
// ============================================================

model TaxRate {
  id                String  @id @default(uuid())
  countryCode       String
  country           Country @relation(fields: [countryCode], references: [iso2])
  state             String?
  taxType           String // "VAT", "GST", "Sales Tax", "Import Duty"
  rate              Decimal @db.Decimal(5, 2) // percentage
  appliesToShipping Boolean @default(false)

  @@index([countryCode])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique // human-readable, e.g. ORD-2026-000123
  buyerId             String
  buyer               User        @relation(fields: [buyerId], references: [id])
  status              OrderStatus @default(PENDING)
  currencyCode        String
  currency            Currency    @relation(fields: [currencyCode], references: [code])
  exchangeRateToUSD   Decimal     @db.Decimal(14, 6)
  subtotal            Decimal     @db.Decimal(12, 2)
  shippingTotal       Decimal     @default(0.00) @db.Decimal(12, 2)
  taxTotal            Decimal     @default(0.00) @db.Decimal(12, 2)
  discountTotal       Decimal     @default(0.00) @db.Decimal(12, 2)
  totalAmount         Decimal     @db.Decimal(12, 2)
  couponId            String?
  coupon              Coupon?     @relation(fields: [couponId], references: [id])
  placedAt            DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items          OrderItem[]
  addresses      OrderAddress[]
  payments       Payment[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]
  refunds        Refund[]
  complaints     Complaint[]
  sellerReviews  SellerReview[]
  couponUsage    CouponUsage?

  @@index([buyerId])
  @@index([status])
  @@index([couponId])
  @@index([placedAt])
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  sellerId         String
  seller           SellerProfile  @relation(fields: [sellerId], references: [id])
  quantity         Int            @default(1)
  unitPrice        Decimal        @db.Decimal(10, 2)
  taxAmount        Decimal        @default(0.00) @db.Decimal(10, 2)
  discountAmount   Decimal        @default(0.00) @db.Decimal(10, 2)
  subtotal         Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())

  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]
  review        ProductReview?

  @@index([orderId])
  @@index([productVariantId])
  @@index([sellerId])
}

model OrderAddress {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        AddressType
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String
  countryCode String
  country     Country     @relation(fields: [countryCode], references: [iso2])

  @@unique([orderId, type])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethodType
  provider      String? // e.g. Stripe, Paystack
  transactionId String?       @unique
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  currencyCode  String
  currency      Currency      @relation(fields: [currencyCode], references: [code])
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

// ============================================================
// FULFILLMENT
// ============================================================

model Shipment {
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id])
  sellerId          String
  seller            SellerProfile  @relation(fields: [sellerId], references: [id])
  warehouseId       String
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id])
  shippingMethodId  String
  shippingMethod    ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  carrier           String
  trackingNumber    String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())

  items ShipmentItem[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

model ShipmentItem {
  id          String    @id @default(uuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int

  @@unique([shipmentId, orderItemId])
}

// ============================================================
// RETURNS & REFUNDS
// ============================================================

model ReturnRequest {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  buyerId     String
  buyer       User         @relation(fields: [buyerId], references: [id])
  reason      ReturnReason
  status      ReturnStatus @default(REQUESTED)
  comment     String?
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?

  items  ReturnItem[]
  refund Refund?

  @@index([orderId])
  @@index([buyerId])
  @@index([status])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  condition       String? // e.g. "unopened", "damaged"

  @@unique([returnRequestId, orderItemId])
}

model Refund {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  paymentId       String?
  payment         Payment?      @relation(fields: [paymentId], references: [id])
  returnRequestId String?       @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  currencyCode    String
  currency        Currency      @relation(fields: [currencyCode], references: [code])
  method          RefundMethod
  status          RefundStatus  @default(PENDING)
  reason          String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  storeCreditEntry StoreCredit?

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}

model StoreCredit {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  currencyCode   String
  currency       Currency        @relation(fields: [currencyCode], references: [code])
  type           StoreCreditType
  balanceAfter   Decimal         @db.Decimal(12, 2)
  relatedRefundId String?        @unique
  relatedRefund  Refund?         @relation(fields: [relatedRefundId], references: [id])
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([userId])
}

// ============================================================
// COMPLAINTS & DISPUTES
// ============================================================

model Complaint {
  id               String            @id @default(uuid())
  complainantId    String
  complainant      User              @relation("ComplaintComplainant", fields: [complainantId], references: [id])
  sellerId         String?
  seller           SellerProfile?    @relation(fields: [sellerId], references: [id])
  orderId          String?
  order            Order?            @relation(fields: [orderId], references: [id])
  category         ComplaintCategory
  priority         ComplaintPriority @default(MEDIUM)
  status           ComplaintStatus   @default(OPEN)
  subject          String
  description      String
  resolution       String?
  assignedAgentId  String?
  assignedAgent    User?             @relation("ComplaintAgent", fields: [assignedAgentId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  resolvedAt       DateTime?

  messages ComplaintMessage[]

  @@index([complainantId])
  @@index([sellerId])
  @@index([orderId])
  @@index([status])
  @@index([assignedAgentId])
}

model ComplaintMessage {
  id            String    @id @default(uuid())
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User      @relation(fields: [senderId], references: [id])
  message       String
  attachmentUrl String?
  createdAt     DateTime  @default(now())

  @@index([complaintId])
}

// ============================================================
// REVIEWS & RATINGS
// ============================================================

model ProductReview {
  id               String       @id @default(uuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User         @relation(fields: [buyerId], references: [id])
  orderItemId      String?      @unique
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id])
  rating           Int // 1-5, enforce range in application layer
  title            String?
  body             String?
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  helpfulCount     Int          @default(0)
  sellerResponse   String?
  respondedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  images ReviewImage[]
  votes  ReviewVote[]

  @@index([productId])
  @@index([buyerId])
  @@index([status])
  @@index([rating])
}

model ReviewImage {
  id        String        @id @default(uuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime      @default(now())

  @@index([reviewId])
}

model ReviewVote {
  id         String        @id @default(uuid())
  reviewId   String
  review     ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  isHelpful  Boolean
  createdAt  DateTime      @default(now())

  @@unique([reviewId, userId])
}

model SellerReview {
  id        String        @id @default(uuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  buyerId   String
  buyer     User          @relation(fields: [buyerId], references: [id])
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  rating    Int // 1-5
  comment   String?
  createdAt DateTime      @default(now())

  @@unique([orderId, sellerId])
  @@index([sellerId])
}

// ============================================================
// Q&A
// ============================================================

model ProductQuestion {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  question    String
  answerCount Int      @default(0)
  createdAt   DateTime @default(now())

  answers ProductAnswer[]

  @@index([productId])
}

model ProductAnswer {
  id             String          @id @default(uuid())
  questionId     String
  question       ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  answer         String
  isSellerAnswer Boolean         @default(false)
  helpfulCount   Int             @default(0)
  createdAt      DateTime        @default(now())

  @@index([questionId])
}

// ============================================================
// MARKETING / DISCOUNTS
// ============================================================

model Coupon {
  id                String     @id @default(uuid())
  code              String     @unique
  type              CouponType
  value             Decimal    @db.Decimal(10, 2)
  minOrderAmount    Decimal?   @db.Decimal(10, 2)
  maxDiscountAmount Decimal?   @db.Decimal(10, 2)
  usageLimit        Int?
  usageLimitPerUser Int?       @default(1)
  usedCount         Int        @default(0)
  startsAt          DateTime
  expiresAt         DateTime
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())

  applicableCategories Category[]
  applicableProducts   Product[]
  orders               Order[]
  usages               CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  discountAmount  Decimal  @db.Decimal(10, 2)
  usedAt          DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([userId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
}
