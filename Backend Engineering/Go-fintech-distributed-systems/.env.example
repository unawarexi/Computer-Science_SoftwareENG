PORT=8080
ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fintech_db
DB_SSLMODE=disable
DB_POOL_MAX_CONNS=100
DB_POOL_MIN_CONNS=10

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fintech_mongo
MONGO_POOL_SIZE=50

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=fintech_group
KAFKA_CLIENT_ID=fintech_backend

# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# External APIs
STRIPE_API_KEY=sk_test_...
ONFIDO_API_KEY=api_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
SENDGRID_API_KEY=SG...

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
